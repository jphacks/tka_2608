// 共有する署名設定。実値はGit管理外のSigning.local.xcconfigで上書きする。
DEVELOPMENT_TEAM =
TODOMERU_BUNDLE_IDENTIFIER = devplaceholder.$(PROJECT_UNIQUE_VALUE:identifier).todomeru-ios
TODOMERU_APP_GROUP_IDENTIFIER = group.$(TODOMERU_BUNDLE_IDENTIFIER)
TODOMERU_APP_PROFILE_SPECIFIER =
TODOMERU_REPORT_PROFILE_SPECIFIER =
TODOMERU_MONITOR_PROFILE_SPECIFIER =
TODOMERU_SHIELD_CONFIGURATION_PROFILE_SPECIFIER =
TODOMERU_SHIELD_ACTION_PROFILE_SPECIFIER =

// Swiftとentitlementsで同じApp Group IDを使うため、Info.plistへ設定値を展開する。
INFOPLIST_EXPAND_BUILD_SETTINGS = YES

// Claude APIのキー。実値はGit管理外のClaudeAPI.local.xcconfigに書く
CLAUDE_API_KEY =

#include? "Signing.local.xcconfig"
#include? "ClaudeAPI.local.xcconfig"
